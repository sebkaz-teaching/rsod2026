# Protect the results viewer with Basic Auth — create the password file
# once on the server (outside the web root, or at least outside a path
# GitHub-published sources reference) with:
#   htpasswd -c /home/youruser/.htpasswds/rsod-quiz/passwd sebastian
# then point AuthUserFile below at that path.
<Files "results.php">
    AuthType Basic
    AuthName "RSOD - wyniki testow"
    AuthUserFile /home/sebastia3/domains/sebastianzajac.pl/.htpasswd/passwd
    Require valid-user
</Files>

# The SQLite file and schema must never be served directly.
<FilesMatch "\.(db|sqlite|sql)$">
    Require all denied
</FilesMatch>

# Config may contain no secrets by default, but config.local.php can —
# never serve either directly.
<Files "config.php">
    Require all denied
</Files>
<Files "config.local.php">
    Require all denied
</Files>

# Fallback if the htpasswd file has to live inside this public folder
# (no SSH / no panel support for placing it outside the web root):
<Files "passwd">
    Require all denied
</Files>
<IfModule mod_alias.c>
    RedirectMatch 404 ^/rsod-quiz/tools/
</IfModule>
